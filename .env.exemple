# Copie en .env et renseigne. .env est ignore par git.
# Toutes ces variables ont un defaut : ce fichier les liste pour que tu saches
# ce qui existe, pas parce qu'il faut toutes les remplir.

# --- Fournisseurs -----------------------------------------------------------
# Chaine de repli, du moins cher au plus cher, separee par des virgules.
# Le premier qui repond gagne ; on ne bascule que sur surcharge.
#   fake                  aucun appel reseau, aucun cout (defaut)
#   ovhcloud,anthropic    OVHcloud d'abord, Anthropic en secours
FOURNISSEURS=fake

# Enveloppe par page, verifiee AVANT chaque essai. Depassee -> l'API renvoie 402.
BUDGET_PAR_PAGE=0.50
# Essais de la boucle de reparation, puis tours de la boucle de correction.
MAX_ESSAIS_REPARATION=2
MAX_TOURS_CORRECTION=3
# Enveloppe estimee par appel, en euros, debitee avant l'essai.
COUT_ESTIME_OVHCLOUD=0.002
COUT_ESTIME_ANTHROPIC=0.01
# Taille maximale de l'invite de redaction, en tokens estimes.
BUDGET_TOKENS_INVITE=1500

# --- OVHcloud AI Endpoints --------------------------------------------------
OVH_API_KEY=
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODELE=Meta-Llama-3_3-70B-Instruct

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Haiku par defaut : ce projet fait tourner des evaluations en boucle.
ANTHROPIC_MODELE=claude-haiku-4-5-20251001

# --- Postgres ---------------------------------------------------------------
# POSTGRES_HOST vide = checkpointer en memoire, qui NE SURVIT PAS au redemarrage.
# Le renseigner bascule sur PostgresSaver. Le DSN est assemble par l'app.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=fabrique
# Requis par docker compose, qui refuse de demarrer sans. Change-le.
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=fabrique

# --- Temporal -----------------------------------------------------------
# Requis pour `python -m fabrique.temporal.worker` : Client.connect() leve
# une erreur si TEMPORAL_HOST est vide. Non utilise par l'API ni LangGraph.
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=fabrique

# --- Langfuse ---------------------------------------------------------------
# Sans ces cles, le client se desactive et l'instrumentation devient un no-op.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
